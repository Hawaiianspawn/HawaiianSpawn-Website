---
import DocsLayout from '../../../../layouts/DocsLayout.astro';

// Same grouping and order as the sidebar in DocsLayout.astro - keep the two in step.
const topics = [
  {
    group: 'Start Here',
    items: [
      {
        href: '/marketplace/mha-manager/docs/installation',
        label: 'Installation',
        desc: 'Install via precompiled binaries or build from source. Enable required engine plugins.',
      },
      {
        href: '/marketplace/mha-manager/docs/quick-start',
        label: 'Quick Start',
        desc: 'Run your first batch in five steps using a Mono job — the fastest path to results.',
      },
    ],
  },
  {
    group: 'Get Footage In',
    items: [
      {
        href: '/marketplace/mha-manager/docs/ingest',
        label: 'Ingest Footage',
        desc: 'Turn raw take folders into Capture Data assets through Live Link Hub or the Add Jobs dialog — manually, or auto-queued as takes arrive.',
      },
      {
        href: '/marketplace/mha-manager/docs/add-jobs',
        label: 'Add Jobs Dialog',
        desc: 'The one dialog that fills the queue — project Capture Data, audio from three sources, and raw footage scanned with your own layout schema.',
      },
      {
        href: '/marketplace/mha-manager/docs/take-naming',
        label: 'Take Naming',
        desc: 'How folder and take names decide a job\'s type, and why the Imports/Actor layout is what lets stereo takes find their calibration and identity.',
      },
    ],
  },
  {
    group: 'Run a Workflow',
    items: [
      {
        href: '/marketplace/mha-manager/docs/job-types',
        label: 'Job Types',
        desc: 'A one-screen chooser — which type to use, what each requires, and what it produces, linking to the workflow guides.',
      },
      {
        href: '/marketplace/mha-manager/docs/mono-workflow',
        label: 'Mono Workflow',
        desc: 'Single-camera footage end to end — framing probe, optional UE 5.8 body tracking, solve, and export.',
      },
      {
        href: '/marketplace/mha-manager/docs/stereo-workflow',
        label: 'Stereo Workflow',
        desc: 'The highest-fidelity path — the calibration to identity to performance chain, depth generation, and the depth-constrained solve.',
      },
      {
        href: '/marketplace/mha-manager/docs/audio-workflow',
        label: 'Audio Workflow',
        desc: 'Facial animation from a voice track alone — SoundWave, WAV folder, or Wwise container; solver mode, mood, and export.',
      },
      {
        href: '/marketplace/mha-manager/docs/wwise-audio',
        label: 'Wwise Audio',
        desc: 'Solve dialogue that lives in a Wwise project, from Wwise\'s own converted media — WAAPI setup, PCM requirement, and the event track on exported sequences.',
      },
    ],
  },
  {
    group: 'Outputs & Review',
    items: [
      {
        href: '/marketplace/mha-manager/docs/exports',
        label: 'Exports',
        desc: 'What a finished job produces and where it lands — asset paths, the _CR / _DCC FBX form gate, folder layouts, and body skeleton modes.',
      },
      {
        href: '/marketplace/mha-manager/docs/level-sequence-preview',
        label: 'Level Sequence Preview',
        desc: 'A framed, self-lit cinematic per job — camera and exposure, baked lighting rigs, face binding for audio, and Preview in Studio.',
      },
    ],
  },
  {
    group: 'Configure',
    items: [
      {
        href: '/marketplace/mha-manager/docs/global-settings',
        label: 'Global Settings',
        desc: 'Export paths and formats, concurrent worker processes, per-category solve defaults, stereo calibration settings, and the re-process toggle.',
      },
      {
        href: '/marketplace/mha-manager/docs/job-options',
        label: 'Per-Job Options',
        desc: 'All 45+ solve parameters exposed per job — frame exclusion, depth cleaning, tongue solve, body tracking, and more.',
      },
      {
        href: '/marketplace/mha-manager/docs/take-overrides',
        label: 'Per-Take Overrides',
        desc: 'Options and decisions that stick to a take rather than a job, recorded as a sparse diff so clearing the queue costs nothing.',
      },
      {
        href: '/marketplace/mha-manager/docs/manifests',
        label: 'Manifests & Batch Assets',
        desc: 'The .mhajson schema for sharing queues across machines, and batch assets — the same queue as a content-tree asset that commits with the project.',
      },
    ],
  },
  {
    group: 'Automate',
    items: [
      {
        href: '/marketplace/mha-manager/docs/ci-mode',
        label: 'Headless / CI Mode',
        desc: 'Run batches from the command line with -run=MHAManager. Exit codes, logging, and example scripts.',
      },
      {
        href: '/marketplace/mha-manager/docs/mcp-toolset',
        label: 'MCP Toolset',
        desc: 'Drive the queue from an MCP client on UE 5.8 — 23 tools for inspecting, editing, and running the queue, plus the tool reference.',
      },
      {
        href: '/marketplace/mha-manager/docs/claude-skills',
        label: 'Claude Skills',
        desc: 'Three Claude Code skills ship with the plugin — MCP setup, live job diagnosis, and take organization. Where to install them and what they need.',
      },
    ],
  },
  {
    group: '',
    items: [
      {
        href: '/marketplace/mha-manager/docs/troubleshooting',
        label: 'Troubleshooting',
        desc: 'Validation errors, depth generation failures, memory limits, and common crash causes.',
      },
    ],
  },
];
---

<DocsLayout
  title="Documentation — MHA Manager"
  description="Full documentation for the MHA Manager UE5 plugin."
  currentSlug="index"
>

  <div class="doc-header">
    <div class="doc-header-meta">
      <span class="version-chip">v2.6.1</span>
      <span class="version-chip">UE 5.5 – 5.8</span>
    </div>
    <h1 class="doc-title">Documentation</h1>
    <p class="doc-lead">
      Everything you need to get MHA Manager running, configured, and integrated
      into your production pipeline.
    </p>
    <a href="/marketplace/mha-manager/docs/installation" class="btn btn-primary start-btn">
      Get started — Installation
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>

  {topics.map(section => (
    <section class="topic-section">
      {section.group && <h2 class="topic-group-label">{section.group}</h2>}
      <div class="topic-grid">
        {section.items.map(item => (
          <a href={item.href} class="topic-card">
            <div class="topic-card-body">
              <span class="topic-title">{item.label}</span>
              <p class="topic-desc">{item.desc}</p>
            </div>
            <svg class="topic-arrow" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </section>
  ))}

</DocsLayout>

<style>
  .doc-header {
    margin-bottom: 56px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--border);
  }

  .doc-header-meta {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
  }

  .version-chip {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    background: var(--bg-surface);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .doc-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .doc-lead {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 540px;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .start-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Topic sections */
  .topic-section {
    margin-bottom: 40px;
  }

  .topic-group-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .topic-grid {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .topic-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, background 0.2s;
  }

  .topic-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--bg-surface);
  }

  .topic-card-body {
    flex: 1;
    min-width: 0;
  }

  .topic-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 3px;
  }

  .topic-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .topic-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.2s;
  }

  .topic-card:hover .topic-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
