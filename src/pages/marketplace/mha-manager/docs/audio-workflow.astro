---
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import DocFigure from '../../../../components/DocFigure.astro';
---

<DocsLayout
  title="Audio Workflow — MHA Manager"
  description="Drive facial animation from an audio track alone — no footage required."
  currentSlug="audio-workflow"
>

  <div class="doc-header">
    <span class="type-badge type-audio">Audio</span>
    <h1 class="doc-title">Audio Workflow</h1>
    <p class="doc-lead">
      Audio drives facial animation from a voice track alone — no footage, calibration, or identity.
      It is the simplest job type to configure, for lip-sync and expression from dialogue when no
      capture footage exists.
    </p>
  </div>

  <DocFigure
    src="/assets/docs/mha/audio-batch.webp"
    alt="Four Audio jobs in the queue, typed Face / Auto Detect, running through Tracking to Done with waveform thumbnails"
    caption="An audio batch — one job per voice track, no footage or identity needed"
  />

  <section class="type-section">
    <h2 class="sub-heading">Pipeline stages</h2>
    <div class="pipeline">
      <div class="pipeline-stage"><span class="stage-name">Validate Input</span></div>
      <div class="pipeline-arrow">-&gt;</div>
      <div class="pipeline-stage"><span class="stage-name">Audio Solve</span><span class="stage-note">Voice -&gt; controls</span></div>
      <div class="pipeline-arrow">-&gt;</div>
      <div class="pipeline-stage"><span class="stage-name">Export Outputs</span></div>
      <div class="pipeline-arrow">-&gt;</div>
      <div class="pipeline-stage"><span class="stage-name">Save Assets</span></div>
    </div>

    <h2 class="sub-heading">Required input</h2>
    <p class="section-desc">
      One voice track per job, from any of three sources in the <strong>Add Jobs...</strong> dialog:
    </p>
    <div class="asset-table">
      <div class="asset-row header"><span>Source</span><span>Type</span><span>Notes</span></div>
      <div class="asset-row">
        <span><strong>Project SoundWave</strong></span>
        <span><code>USoundWave</code></span>
        <span>A sound wave asset already in the content tree</span>
      </div>
      <div class="asset-row">
        <span><strong>WAV folder</strong></span>
        <span>Files on disk</span>
        <span>The WAV stays where it is; each job imports it beside the Performance at solve time</span>
      </div>
      <div class="asset-row">
        <span><strong>Wwise container</strong></span>
        <span>Resolved over WAAPI</span>
        <span>Solves from Wwise's own converted media; conversions must be PCM. See <a href="/marketplace/mha-manager/docs/wwise-audio">Wwise Audio</a></span>
      </div>
    </div>
    <div class="callout callout-tip">
      Audio jobs do <strong>not</strong> require Capture Data, a MetaHuman Identity, or a Camera
      Calibration — a voice track is the whole input.
    </div>
    <div class="callout callout-note">
      Audio solves need <strong>UE 5.8</strong>. The solve runs on 5.8-only Performance APIs, so on
      UE 5.7 an audio job fails immediately with a version message; the rest of the plugin works
      normally.
    </div>
  </section>

  <section class="type-section">
    <h2 class="section-title">Audio options</h2>
    <div class="option-list">
      <div class="option-row">
        <span class="option-name">Solver Mode</span>
        <span class="option-desc"><strong>Realtime</strong> — faster, lower quality, good for previews and iteration. <strong>Offline</strong> — slower, higher quality; use for final deliverables.</span>
      </div>
      <div class="option-row">
        <span class="option-name">Mood Preset</span>
        <span class="option-desc">Sets the emotional baseline used to color the animation — Neutral, Happy, Sad, Angry, Surprised, Disgusted, Fearful. The solver blends detected phonemes against this mood.</span>
      </div>
      <div class="option-row">
        <span class="option-name">Mood Intensity</span>
        <span class="option-desc">Blend weight for the Mood Preset — lower values keep the animation closer to neutral while retaining a hint of the chosen mood.</span>
      </div>
      <div class="option-row">
        <span class="option-name">Output Controls</span>
        <span class="option-desc">Which control-rig channels the solve drives: <strong>Full Face</strong>, <strong>Lips Only</strong>, or <strong>Eyelids Only</strong>.</span>
      </div>
      <div class="option-row">
        <span class="option-name">Blink Generation</span>
        <span class="option-desc">Auto-generates natural blinks when the solve produces no blink data. Enabled by default; disable if blinks come from a separate system.</span>
      </div>
      <div class="option-row">
        <span class="option-name">Downmix Channels / Audio Channel</span>
        <span class="option-desc">Downmixes multi-channel audio to mono by default. Disable to solve from a single channel, then set Audio Channel (0-indexed — 1 for dialogue on the right channel).</span>
      </div>
      <div class="option-row">
        <span class="option-name">Lookahead Window</span>
        <span class="option-desc">How far ahead (ms) the solver reads the signal for anticipatory cues, e.g. jaw pre-opening before a vowel. Default 80 ms — raise for more anticipation, lower for tighter sync.</span>
      </div>
    </div>
  </section>

  <section class="type-section">
    <h2 class="sub-heading">Outputs</h2>
    <div class="asset-table">
      <div class="asset-row header"><span>Output</span><span>When</span><span>Notes</span></div>
      <div class="asset-row">
        <span><strong>Performance + AnimSequence</strong></span>
        <span>Always</span>
        <span>Solved performance plus baked face animation, driving full-face or mouth-only controls per Output Controls</span>
      </div>
      <div class="asset-row">
        <span><strong>FBX exports</strong></span>
        <span>Optional</span>
        <span>Enabled in Global Settings; face jobs get the Control Rig <code>_CR</code> form</span>
      </div>
    </div>
  </section>

</DocsLayout>

<style>
  .doc-header { margin-bottom: 40px; }

  .type-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }
  .type-audio { background: color-mix(in srgb, #c084fc 12%, transparent); color: #c084fc; border: 1px solid color-mix(in srgb, #c084fc 30%, transparent); }

  .doc-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .doc-lead {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 620px;
    line-height: 1.7;
  }

  .doc-lead code, .callout code, .asset-row code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }

  .type-section {
    margin-bottom: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--border);
  }
  .type-section:last-of-type { border-bottom: none; }

  .sub-heading {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    margin: 24px 0 10px;
  }
  .sub-heading:first-child { margin-top: 0; }

  .section-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .asset-table {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 4px;
  }

  .asset-row {
    display: grid;
    grid-template-columns: 1.1fr 1.3fr 1.4fr;
    gap: 16px;
    padding: 10px 16px;
    font-size: 0.825rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }

  .asset-row:last-child { border-bottom: none; }

  .asset-row.header {
    background: var(--bg-surface);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .asset-row strong { color: var(--text); font-weight: 500; }

  .pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 4px 0 8px;
  }

  .pipeline-stage {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 7px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stage-name { font-size: 0.8rem; font-weight: 600; color: var(--text); }
  .stage-note { font-size: 0.7rem; color: var(--accent); }
  .pipeline-arrow { color: var(--text-muted); font-size: 0.9rem; font-family: var(--font-mono); }

  .option-list {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .option-row {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 20px;
    padding: 12px 16px;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .option-row:last-child { border-bottom: none; }
  .option-name { font-weight: 600; color: var(--text); font-size: 0.825rem; }
  .option-desc { color: var(--text-muted); line-height: 1.5; }
  .option-desc strong { color: var(--text); font-weight: 500; }

  .section-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 12px;
  }

  .callout {
    padding: 14px 18px;
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 16px 0;
    border-left: 3px solid;
    color: var(--text-muted);
  }
  .callout-tip { background: color-mix(in srgb, var(--accent) 8%, transparent); border-color: var(--accent); }
  .callout-note { background: var(--bg-surface); border-color: var(--border); }
  .callout strong { color: var(--text); font-weight: 600; }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .asset-row { grid-template-columns: 1fr 1fr; }
    .asset-row span:last-child { display: none; }
    .asset-row.header span:last-child { display: none; }
    .option-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
