---
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import DocFigure from '../../../../components/DocFigure.astro';

const settings = [
  {
    name: 'Auto-Queue Ingested Takes',
    section: 'Ingest',
    default: 'On',
    desc: 'Watches the project for new Footage Capture Data assets — takes pushed from Live Link Hub / Capture Manager — and queues them automatically. Takes already in the queue are never re-added. When Live Link Hub exits, a sweep also picks up takes that were already in the project or arrived while the watcher was off.',
    note: null,
  },
  {
    name: 'Auto-Start Batch on Ingest',
    section: 'Ingest',
    default: 'Off',
    desc: 'Starts the batch when auto-queued takes arrive and nothing is running. Takes arriving mid-batch are queued and started on the next idle trigger.',
    note: null,
  },
  {
    name: 'Watch Folder (optional)',
    section: 'Ingest',
    default: 'Empty (all of /Game)',
    desc: 'Content path prefix to restrict the watcher to, for example <code>/Game/CaptureManager/Ingest</code>.',
    note: null,
  },
  {
    name: 'WAAPI Endpoint / Default Container / Platform / Language',
    section: 'Wwise',
    default: '<code>http://127.0.0.1:8090/waapi</code>, empty, Windows, English(US)',
    desc: 'Where the Wwise Authoring API lives, which container to enumerate when a Wwise enqueue names none, and which converted media the solve reads. See <a href="/marketplace/mha-manager/docs/wwise-audio">Wwise Audio</a>.',
    note: null,
  },
  {
    name: 'Reprocess Solved Takes',
    section: 'Execution',
    default: 'Off',
    desc: 'Off, a job whose Performance asset already exists and contains solved animation skips straight to export instead of solving again — the right behaviour when re-running a batch after a partial failure. Turn it on to force the solve to run regardless. Identity Create and Stereo Calibration jobs are unaffected: they go straight to Done when their identity or calibration already exists.',
    note: 'A solved job whose options changed since it ran is marked <strong>Stale</strong> and re-solved by the next Start Batch, whatever this setting says.',
  },
  {
    name: 'Always Export Animation',
    section: 'Execution',
    default: 'Off',
    desc: 'Re-exports a job\'s AnimSequence on every run, even when <strong>Overwrite Existing Assets</strong> is off and one already exists. Only the AnimSequence — LevelSequence and Control Rig FBX still respect the overwrite setting.',
    note: 'Use this when you have changed export settings (curve interpolation, head movement) and want updated animation without re-running the full solve.',
  },
  {
    name: 'Export AnimSequence',
    section: 'Export',
    default: 'On',
    desc: 'Bakes the solved performance into a <code>UAnimSequence</code> asset. Turn it off for solve-only runs.',
    note: null,
  },
  {
    name: 'Overwrite Existing Assets',
    section: 'Export',
    default: 'On',
    desc: 'Overwrites assets at the output path if they already exist. Off, export is skipped for any asset that is already there, unless Always Export Animation overrides it.',
    note: null,
  },
  {
    name: 'Open in Editor After Export',
    section: 'Export',
    default: 'Off',
    desc: 'Opens the exported AnimSequence in its asset editor when a job completes. Best for single-job runs; no effect headless.',
    note: null,
  },
  {
    name: 'Custom UE Export Directory',
    section: 'Export',
    default: 'Off (<code>/Game/CaptureManager/Export</code> when enabled)',
    desc: 'Off, generated Performance and animation assets are saved next to the source Capture Data asset. On, everything is collected in the Content Browser folder below instead.',
    note: null,
  },
  {
    name: 'No Per-Take Subfolders',
    section: 'Export',
    default: 'On',
    desc: 'Places all generated assets directly in the UE export directory. Turn it off to give each take a subfolder named after its source Capture Data\'s folder. Affects newly created jobs only.',
    note: null,
  },
  {
    name: 'Use MetaHuman ID Mesh',
    section: 'Export',
    default: 'On',
    desc: 'Targets the exported AnimSequence at the skeletal mesh of the job\'s MetaHuman Identity. Off, the Fallback Target Skeleton below is used instead. Queue-wide — there is no per-job override.',
    note: null,
  },
  {
    name: 'Fallback Target Skeleton',
    section: 'Export',
    default: 'Face_Archetype_Skeleton',
    desc: 'Skeleton or skeletal mesh used as the export target when Use MetaHuman ID Mesh is off.',
    note: null,
  },
  {
    name: 'Export FBX for DCC',
    section: 'Export',
    default: 'Off',
    desc: 'Writes the job-appropriate FBX for Maya, Blender, and other DCC tools. One toggle, not two — the form is derived from the solve: body-tracking jobs get the baked-joint <code>&lt;name&gt;_DCC.fbx</code>, face jobs get the animator-editable Control Rig <code>&lt;name&gt;_CR.fbx</code>. See <a href="/marketplace/mha-manager/docs/exports">Exports</a>.',
    note: null,
  },
  {
    name: 'Reduce Control Rig Keys',
    section: 'Export',
    default: 'Off',
    desc: 'Thins the Control Rig bake before FBX export. The bake writes one key per frame on every channel and Epic\'s own Control Rig FBX exporter has no key-reduction option, so dense bakes stay dense. This drops keys that do not meaningfully change the curve, refitting tangents to compensate.',
    note: null,
  },
  {
    name: 'DCC Export Directory',
    section: 'Export',
    default: '<code>&lt;ProjectSaved&gt;/MHAManager/Exports</code>',
    desc: 'Disk folder where the FBX files are written. <strong>Open Export Folder</strong> in the toolbar opens whatever it is currently set to.',
    note: null,
  },
  {
    name: 'DCC Folder Layout',
    section: 'Export',
    default: 'Per Take',
    desc: 'Folder structure under the export directory: <strong>Per Take</strong> (a subfolder per source take), <strong>Actor / Part</strong> (<code>&lt;Actor&gt;/Face</code> or <code>/Body</code>), or <strong>Flat</strong> (everything in one folder).',
    note: null,
  },
  {
    name: 'Export Take Audio (WAV)',
    section: 'Export',
    default: 'On',
    desc: 'Writes the take\'s audio beside the exported FBX as <code>&lt;AnimName&gt;.wav</code>, trimmed and timecode-aligned to the same range the FBX animation covers, so audio and animation line up at frame 0 in the DCC. Skipped when the take has no audio track.',
    note: null,
  },
  {
    name: 'Export LevelSequence',
    section: 'Export',
    default: 'On',
    desc: 'Also bakes the animation into a <code>ULevelSequence</code> — framed, self-lit, and playable on its own. The face binding, lighting rig, and preview backdrop sit under it as their own rows; see <a href="/marketplace/mha-manager/docs/level-sequence-preview">Level Sequence Preview</a>.',
    note: null,
  },
  {
    name: 'Clean Depth',
    section: 'Camera Calibration and Depth (whole queue)',
    default: 'Off',
    desc: 'Runs the automatic depth-cleaning pass before every depth-footage solve: per-sequence depth range, per-frame noise cutoff, hole filling, temporal smoothing, and foreground isolation, all data-driven. Depth footage only — Mono and Audio jobs ignore it. Queue-wide, with no per-job override.',
    note: null,
  },
  {
    name: 'Body Target Mesh',
    section: 'Camera Calibration and Depth (whole queue)',
    default: 'SKM_Body',
    desc: 'Global default <code>USkeletalMesh</code> for body-tracked jobs whose Body Export Skeleton is Existing Skeleton. A per-job Body Target Mesh takes priority.',
    note: null,
  },
  {
    name: 'Max Concurrent Jobs',
    section: 'Advanced',
    default: '1',
    desc: 'How many takes are solved simultaneously (1-8). Sequential mode (1) is the safest and lowest-memory option. Values above 1 launch separate worker processes that each solve a take side by side — real parallelism, since Epic\'s MetaHuman pipeline only allows one solve per editor instance.',
    note: 'Each extra slot costs one subprocess and 2-5 GB of RAM. Stereo depth generation still runs serially before jobs enter the parallel pool.',
  },
  {
    name: 'Force DX12 for Worker Processes',
    section: 'Advanced',
    default: 'Off',
    desc: 'Launches subprocess workers with <code>-d3d12</code> so headless jobs use DirectX 12 even if the editor session was started differently.',
    note: null,
  },
  {
    name: 'Add MetaHuman Skeleton Compatibility',
    section: 'Advanced',
    default: 'On',
    desc: 'Auto-registers a body export\'s target skeleton as compatible with the MetaHuman base skeleton, so face and body animation play back together without a manual compatibility step.',
    note: null,
  },
  {
    name: 'Retargeter Output Path',
    section: 'Advanced',
    default: '<code>/Game/CaptureManager/BodyTrackerTargets</code>',
    desc: 'Content Browser folder where <strong>+ Create Retargeter...</strong> saves new IK Retargeter assets, named <code>RTG_SMPL_&lt;MeshName&gt;</code> automatically.',
    note: null,
  },
];
---

<DocsLayout
  title="Global Settings — MHA Manager"
  description="Reference for all global settings in the MHA Manager plugin."
  currentSlug="global-settings"
>

  <div class="doc-header">
    <h1 class="doc-title">Global Settings</h1>
    <p class="doc-lead">
      Global settings apply to every job in the queue. They are configured once in the settings
      panel at the top of the MHA Manager tab. Settings persist between sessions and
      are saved in the batch manifest. Most rows carry a revert arrow that puts them back to the
      default shown here.
    </p>
  </div>

  <div class="settings-list">
    {settings.map(s => (
      <div class="setting-row">
        <div class="setting-meta">
          <span class="setting-name">{s.name}</span>
          <span class="setting-section">{s.section}</span>
          <span class="setting-default">Default: <Fragment set:html={s.default} /></span>
        </div>
        <div class="setting-body">
          <p class="setting-desc" set:html={s.desc} />
          {s.note && (
            <div class="callout callout-note">
              <Fragment set:html={s.note} />
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  <section class="extra-section">
    <h2 class="extra-title">Solve Defaults — per-category templates</h2>
    <DocFigure
      src="/assets/docs/mha/gs-solve-defaults.webp"
      alt="Solve Defaults section — Mono / Stereo / Audio picker at top, embedded job-settings panel below editing the Mono template with Body Tracking toggle visible"
      caption="The Solve Defaults section — pick a category, edit its template with the same panel a real job uses"
    />
    <p class="extra-desc">
      New jobs inherit their starting solve options from one of three templates, chosen by the
      job's solve category: <strong>Mono</strong>, <strong>Depth Footage</strong> (stereo), or
      <strong>Audio</strong>. Set your preferred options once per category instead of per job. The
      Solve Defaults section in the settings panel shows a 3-way picker above an embedded
      job-settings panel — it is the same widget used for a queued job, editing the chosen template
      instead of a specific job.
    </p>
    <p class="extra-desc">
      A new job is seeded from the template matching its category at creation time. If a queued
      job's category later changes (e.g. its Type changes from Mono to Stereo), its options are
      re-seeded from the newly matching template — frame exclusions marked on the job are
      preserved, everything else resets. Asset-picker fields you leave empty are pre-filled with
      the engine's real defaults on startup, so the UI shows the actual asset that will be used;
      your own choices are never overwritten. The Stereo and Audio templates default their Control
      Rig Class to <code>Face_ControlBoard_CtrlRig</code> — the only rig whose control names line
      up with MetaHuman's facial curve data.
    </p>
  </section>

  <section class="extra-section">
    <h2 class="extra-title">Stereo Calibration settings</h2>
    <p class="extra-desc">
      These settings control <a href="/marketplace/mha-manager/docs/stereo-workflow#calibration-identity">Stereo Calibration jobs</a>
      queued from checkerboard takes. A bad calibration poisons the depth of every take built on it,
      so the two quality gates below sit upstream of processing.
    </p>
    <div class="callout callout-note">
      <strong>Both gates are trust gates, not silent filters.</strong> A calibration that exceeds
      either threshold is set aside and its job pauses as <strong>PoorCalibrationQuality</strong> —
      dependent takes wait rather than consume it. You then <strong>Accept Anyway</strong> or re-solve;
      the pipeline never quietly ships or drops a questionable calibration.
    </div>
    <div class="settings-list">
      <div class="setting-row">
        <div class="setting-meta">
          <span class="setting-name">Board Width (squares) / Height</span>
          <span class="setting-default">Default: <code>11 x 16</code></span>
        </div>
        <div class="setting-body">
          <p class="setting-desc">Checkerboard dimensions measured in <strong>squares</strong>, not inner corners. The defaults match Epic's shipped calibration board (11 x 16 squares). With the board override off these are learned state — the auto-detect probe writes its winning dimensions back here to seed the next run.</p>
        </div>
      </div>
      <div class="setting-row">
        <div class="setting-meta">
          <span class="setting-name">Square Size (cm)</span>
          <span class="setting-default">Default: <code>0.75 cm</code></span>
        </div>
        <div class="setting-body">
          <p class="setting-desc">Physical size of one board square. This cannot be measured from footage — a wrong value silently scales the stereo baseline and therefore all reconstructed depth. Measure your printed board. Only takes effect while <strong>Override Default Board</strong> is on.</p>
        </div>
      </div>
      <div class="setting-row">
        <div class="setting-meta">
          <span class="setting-name">Override default board</span>
          <span class="setting-default">Default: <code>Off</code></span>
        </div>
        <div class="setting-body">
          <p class="setting-desc">Off, the plugin assumes Epic's shipped board and lets Board Pattern and Square Size auto-detect. On, your Board Pattern W/H and Square Size are pinned verbatim — the probe only tries them and their swapped orientation, and detection never writes back over them. Use this for a non-Epic board. You can save named boards as <strong>presets</strong> in this sub-section and switch between them.</p>
        </div>
      </div>
      <div class="setting-row">
        <div class="setting-meta">
          <span class="setting-name">Sharpness auto-tune</span>
          <span class="setting-default">Not a setting</span>
        </div>
        <div class="setting-body">
          <p class="setting-desc">Blurry frames are rejected during frame selection by a threshold the plugin tunes itself (5.0 px to start) and stores for the next locked-frame retry. Likewise, with the board override off the board pattern is probed across a handful of frames — your last winner, its transpose, an inner-corner misentry, Epic's board — before the full-take scan, and the winning dimensions are written back. Neither is an editable row; both appear in the manifest as learned state.</p>
        </div>
      </div>
      <div class="setting-row">
        <div class="setting-meta">
          <span class="setting-name">Max RMS Error (px)</span>
          <span class="setting-default">Default: <code>1.0 px</code></span>
        </div>
        <div class="setting-body">
          <p class="setting-desc">The primary quality gate. Calibration is ranked by <strong>out-of-sample validation RMS</strong> — error measured on frames it did not train on — because a solve's own training error overfits and hides a bad result. Above this value the job pauses as PoorCalibrationQuality.</p>
          <div class="callout callout-note">
            <strong>Why 1.0.</strong> On a reference rig, downstream solve quality was flat across validation RMS 0.6–1.1 px and clearly degraded by 2.4 px (depth coverage −5%, jitter +58%), with the quality knee between the two. A tighter gate like 0.5 rejects even a rig's best achievable solve; 1.0 accepts the healthy range and rejects the degraded tail with margin. Treat 0.8–1.2 as a sensible window, not a universal constant.
          </div>
        </div>
      </div>
      <div class="setting-row">
        <div class="setting-meta">
          <span class="setting-name">Min Score</span>
          <span class="setting-default">Default: <code>0.5</code></span>
        </div>
        <div class="setting-body">
          <p class="setting-desc">A second, coarser gate on Epic's 0–1 diagnostics score, evaluated against the consuming take's own footage. It catches <strong>structurally broken</strong> calibrations (a wrong-route solve scores around 0.2) but cannot rank frame-set quality — a slightly worse calibration can score marginally higher. Leave it as a structural safety net; do not tighten it expecting finer quality discrimination. Below this value the job pauses.</p>
        </div>
      </div>
      <div class="setting-row">
        <div class="setting-meta">
          <span class="setting-name">Export calib.json</span>
          <span class="setting-default">Default: <code>Off</code></span>
        </div>
        <div class="setting-body">
          <p class="setting-desc">Also writes an OpenCV-model <code>calib.json</code> into the take's footage folder on disk, in the format Capture Manager's stereo HMC ingest reads. An existing calib.json is never overwritten.</p>
        </div>
      </div>
    </div>
  </section>

</DocsLayout>

<style>
  .doc-header { margin-bottom: 40px; }

  .extra-section {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .extra-title {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }

  .extra-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 640px;
    margin-bottom: 14px;
  }

  .extra-desc strong { color: var(--text); font-weight: 600; }

  .extra-desc a { color: var(--accent); text-decoration: none; }
  .extra-desc a:hover { text-decoration: underline; }

  .extra-desc code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--bg-surface);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .doc-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .doc-lead {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.7;
  }

  .settings-list {
    display: flex;
    flex-direction: column;
  }

  .setting-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }

  .setting-row:last-child { border-bottom: none; }

  .setting-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 2px;
  }

  .setting-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .setting-section {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .setting-default {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  :global(.setting-default code) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--bg-surface);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .setting-default code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--bg-surface);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .setting-body { min-width: 0; }

  .setting-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  :global(.setting-desc code) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--bg-surface);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .callout {
    padding: 12px 16px;
    border-radius: var(--radius);
    font-size: 0.825rem;
    line-height: 1.6;
    margin-top: 12px;
    border-left: 3px solid;
  }

  .callout-note {
    background: color-mix(in srgb, #f0a500 8%, transparent);
    border-color: #f0a500;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .setting-row { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
