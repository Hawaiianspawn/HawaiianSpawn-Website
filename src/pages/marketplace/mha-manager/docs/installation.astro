</style>

<script>
  // Track switcher (Precompiled / From Source)
  const trackBtns = document.querySelectorAll<HTMLButtonElement>('.track-btn');
  const trackPanels = document.querySelectorAll<HTMLElement>('.track-panel');

  trackBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.track;
      trackBtns.forEach(b => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-selected', String(b === btn));
      });
      trackPanels.forEach(panel => {
        panel.classList.toggle('hidden', panel.dataset.panel !== target);
      });
    });
  });

  // Method switcher (Epic Launcher / Manual) — scoped inside binaries panel
  const methodBtns = document.querySelectorAll<HTMLButtonElement>('.method-btn');
  const methodPanels = document.querySelectorAll<HTMLElement>('.method-panel');

  methodBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.method;
      methodBtns.forEach(b => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-selected', String(b === btn));
      });
      methodPanels.forEach(panel => {
        panel.classList.toggle('hidden', panel.dataset.methodPanel !== target);
      });
    });
  });
</script>
