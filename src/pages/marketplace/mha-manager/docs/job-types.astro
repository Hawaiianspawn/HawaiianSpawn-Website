---
import DocsLayout from '../../../../layouts/DocsLayout.astro';

const types = [
  {
    badge: 'Mono', badgeClass: 'type-mono',
    href: '/marketplace/mha-manager/docs/mono-workflow',
    use: 'A single color camera — head-mounted or any single-lens setup. The fastest type and the right default for most takes.',
    requires: 'Capture Data only',
    produces: 'Performance + face AnimSequence; optional body animation (UE 5.8)',
  },
  {
    badge: 'Stereo', badgeClass: 'type-stereo',
    href: '/marketplace/mha-manager/docs/stereo-workflow',
    use: 'A multi-camera head-mounted rig. Highest fidelity — the depth-constrained solve resolves geometry mono footage cannot.',
    requires: 'Capture Data + Identity + Camera Calibration',
    produces: 'Performance + face AnimSequence (depth-constrained)',
  },
  {
    badge: 'Audio', badgeClass: 'type-audio',
    href: '/marketplace/mha-manager/docs/audio-workflow',
    use: 'A voice track with no footage. Generates lip-sync and expression from dialogue alone.',
    requires: 'A voice track — SoundWave, WAV on disk, or Wwise sound (UE 5.8)',
    produces: 'Performance + face AnimSequence (full-face or mouth-only)',
  },
  {
    badge: 'Calibration', badgeClass: 'type-calib',
    href: '/marketplace/mha-manager/docs/stereo-workflow#calibration-identity',
    use: 'A stereo checkerboard take. Preflight step that produces the calibration every stereo take needs.',
    requires: 'Checkerboard Capture Data (2 image sequences)',
    produces: 'CameraCalibration asset (+ optional calib.json)',
  },
  {
    badge: 'Identity', badgeClass: 'type-identity',
    href: '/marketplace/mha-manager/docs/stereo-workflow#calibration-identity',
    use: 'A stereo identity take. Preflight step that builds and rigs the MetaHuman Identity every stereo take needs.',
    requires: 'Identity Capture Data + Camera Calibration',
    produces: 'Rigged, prepared MetaHumanIdentity (MHID_<Actor>)',
  },
];
---

<DocsLayout
  title="Job Types — MHA Manager"
  description="Which job type to use — a quick comparison of Mono, Stereo, Audio, Calibration, and Identity Create."
  currentSlug="job-types"
>

  <div class="doc-header">
    <h1 class="doc-title">Job Types</h1>
    <p class="doc-lead">
      Every job in the queue has a type that determines which MetaHuman Animator pipeline it runs and
      what it requires. Use this page to pick the right one — then follow its workflow guide for the
      full detail. Types are usually assigned automatically from the take, and you can change a row's
      type at any time.
    </p>
  </div>

  <div class="chooser">
    <div class="chooser-row header">
      <span>Type</span>
      <span>Use it when</span>
      <span>Requires</span>
      <span>Produces</span>
    </div>
    {types.map(t => (
      <a class="chooser-row" href={t.href}>
        <span><span class={`type-badge ${t.badgeClass}`}>{t.badge}</span></span>
        <span class="cell-use">{t.use}</span>
        <span class="cell-req">{t.requires}</span>
        <span class="cell-prod">{t.produces}</span>
      </a>
    ))}
  </div>

  <div class="callout callout-note">
    <strong>Calibration</strong> and <strong>Identity Create</strong> are not performance solves —
    they are the two preflight jobs that produce the assets every Stereo take depends on. They run
    first in the queue automatically. See the
    <a href="/marketplace/mha-manager/docs/stereo-workflow">Stereo Workflow</a> for how the chain
    fits together.
  </div>

  <div class="guide-links">
    <a href="/marketplace/mha-manager/docs/mono-workflow" class="guide-link">
      <span class="guide-label">Guide</span>
      <span class="guide-title">Mono Workflow</span>
    </a>
    <a href="/marketplace/mha-manager/docs/stereo-workflow" class="guide-link">
      <span class="guide-label">Guide</span>
      <span class="guide-title">Stereo Workflow</span>
    </a>
    <a href="/marketplace/mha-manager/docs/audio-workflow" class="guide-link">
      <span class="guide-label">Guide</span>
      <span class="guide-title">Audio Workflow</span>
    </a>
  </div>

</DocsLayout>

<style>
  .doc-header { margin-bottom: 32px; }

  .doc-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .doc-lead {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 620px;
    line-height: 1.7;
  }

  .chooser {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 20px;
  }

  .chooser-row {
    display: grid;
    grid-template-columns: 0.7fr 1.8fr 1.5fr 1.6fr;
    gap: 18px;
    padding: 14px 18px;
    font-size: 0.825rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    align-items: start;
    line-height: 1.5;
    text-decoration: none;
    transition: background 0.15s;
  }

  a.chooser-row:hover { background: var(--bg-surface); }
  .chooser-row:last-child { border-bottom: none; }

  .chooser-row.header {
    background: var(--bg-surface);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cell-req { color: var(--text); }
  .cell-prod { color: var(--text-muted); }

  .type-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    white-space: nowrap;
  }

  .type-mono   { background: color-mix(in srgb, #4a9eff 12%, transparent); color: #4a9eff; border: 1px solid color-mix(in srgb, #4a9eff 30%, transparent); }
  .type-stereo { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
  .type-audio  { background: color-mix(in srgb, #c084fc 12%, transparent); color: #c084fc; border: 1px solid color-mix(in srgb, #c084fc 30%, transparent); }
  .type-calib  { background: color-mix(in srgb, #f0a500 12%, transparent); color: #f0a500; border: 1px solid color-mix(in srgb, #f0a500 30%, transparent); }
  .type-identity { background: color-mix(in srgb, #4ade80 12%, transparent); color: #4ade80; border: 1px solid color-mix(in srgb, #4ade80 30%, transparent); }

  .callout {
    padding: 14px 18px;
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 28px;
    border-left: 3px solid #f0a500;
    background: color-mix(in srgb, #f0a500 8%, transparent);
    color: var(--text-muted);
  }
  .callout strong { color: var(--text); font-weight: 600; }
  .callout a, .doc-lead a { color: var(--accent); text-decoration: none; }
  .callout a:hover { text-decoration: underline; }

  .guide-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .guide-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    padding: 12px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s;
    flex: 1;
    min-width: 160px;
  }

  .guide-link:hover { border-color: var(--accent); }
  .guide-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }
  .guide-title { font-size: 0.9rem; font-weight: 600; color: var(--accent); }

  @media (max-width: 720px) {
    .chooser-row { grid-template-columns: 1fr; gap: 6px; }
    .chooser-row.header { display: none; }
    .cell-req::before { content: "Requires: "; color: var(--text-muted); font-weight: 600; }
    .cell-prod::before { content: "Produces: "; color: var(--text-muted); font-weight: 600; }
  }
</style>
