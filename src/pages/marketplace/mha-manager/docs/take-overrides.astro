  code {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--accent);
    background: var(--bg-surface);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  a { color: var(--accent); text-decoration: none; }
