    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .store-row, .restore-row, .key-row {
    display: grid;
    gap: 16px;
    padding: 11px 16px;
    font-size: 0.825rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    align-items: start;
