---
import DocsLayout from '../../../../layouts/DocsLayout.astro';

const issues = [
  {
    id: 'rebuild-prompt',
    symptom: 'Editor prompts to rebuild modules on every launch',
    cause: 'The precompiled binaries do not match the installed engine version.',
    fix: 'Either switch to the From Source installation path and rebuild against your exact engine version, or download a binary release that matches your UE version exactly.',
    type: 'install',
  },
  {
    id: 'plugin-missing',
    symptom: '"MHA Batch Processor" does not appear in Window menu',
    cause: 'The plugin is not enabled or did not load.',
    fix: 'Go to <strong>Edit → Plugins</strong>, search for "MHA Batch Processor", and enable it. If it is missing from the list entirely, verify the plugin folder is in <code>YourProject/Plugins/MHABatchProcessor/</code> with a valid <code>.uplugin</code> file.',
    type: 'install',
  },
  {
    id: 'validation-red-x',
    symptom: 'Red X icon on a job row — validation fails',
    cause: 'A required asset is missing or its content path cannot be resolved.',
    fix: 'Hover over the red X for the specific validation message. Common causes: Capture Data or Identity asset was moved or renamed after being added to the queue; the Identity auto-discovery folder structure does not match the expected layout. Re-assign the asset in the affected cell.',
    type: 'queue',
  },
  {
    id: 'missing-identity',
    symptom: 'Identity column is empty after adding a Mono or Stereo job',
    cause: 'Auto-discovery could not find a MetaHuman Identity under a predictable folder relative to the Capture Data asset.',
    fix: 'Assign the Identity manually by clicking the Identity cell in the job row and using the asset picker. The plugin looks for <code>UMetaHumanIdentity</code> assets in a sibling or parent folder named <code>MetaHumans</code> — reorganize your Content Browser layout to match if you want auto-discovery to work.',
    type: 'queue',
  },
  {
    id: 'depth-gen-fail',
    symptom: 'Stereo job fails at "GenerateDepth" stage',
    cause: 'One or more depth generation prerequisites are missing or misconfigured.',
    fix: 'Verify: (1) The Capture Data asset references two valid image sequences. (2) A Camera Calibration asset is assigned to the job. (3) The ImgMedia plugin is enabled. (4) The depth output directory is writable. Check the job log panel for the specific error from the depth generator.',
    type: 'stereo',
  },
  {
    id: 'depth-quality',
    symptom: 'Stereo solve quality is poor — face looks incorrect or distorted',
    cause: 'Depth map contains holes, noise, or out-of-range values that degrade the solve.',
    fix: 'Enable <strong>Depth Cleaning</strong> in the job\'s stereo options. Set <strong>Depth Clamp Min</strong> and <strong>Max</strong> to clip background noise. If the face is partially out of frame on many frames, lower <strong>Face Coverage Threshold</strong> or <strong>Face Width Threshold</strong> — or mark those frames in <strong>Frame Exclusion Ranges</strong>.',
    type: 'stereo',
  },
  {
    id: 'out-of-memory',
    symptom: 'Editor crashes or becomes unresponsive during batch processing',
    cause: 'Insufficient RAM for the number of concurrent jobs.',
    fix: 'Set <strong>Max Concurrent Jobs</strong> back to 1 in Global Settings. Sequential processing is stable on 16 GB RAM. For concurrent jobs, 32+ GB is required per active job slot. If the crash persists on a single job, the issue is the solver itself — check Epic\'s MetaHuman Animator documentation for system requirements.',
    type: 'performance',
  },
  {
    id: 'slow-solve',
    symptom: 'Solve is much slower than expected',
    cause: 'GPU not being used, or D3D12 not active on a system that benefits from it.',
    fix: 'Enable <strong>Force D3D12</strong> in Global Settings and re-run. Also verify your GPU drivers are up to date and that the editor is running on the discrete GPU rather than an integrated graphics adapter (check Windows Graphics Settings → Hardware-accelerated GPU scheduling).',
    type: 'performance',
  },
  {
    id: 'anim-missing',
    symptom: 'Batch completes but AnimSequence is not in the output path',
    cause: '<strong>Export AnimSequence</strong> is disabled in Global Settings, or the export step failed silently.',
    fix: 'Check that <strong>Export AnimSequence</strong> is enabled in Global Settings. Then open the manifest at <code>Saved/MHABatchProcessor/batch.mhajson</code> and check the artifact state for the job — if it shows <code>"State": "Failed"</code> for the AnimSequence artifact, the job log will contain the export error.',
    type: 'output',
  },
  {
    id: 'wrong-skeleton',
    symptom: 'AnimSequence is on the wrong skeleton or cannot be applied to the MetaHuman',
    cause: '<strong>Use MetaHuman ID for Output Mesh</strong> is disabled, causing export to target the generic archetype skeleton.',
    fix: 'Enable <strong>Use MetaHuman ID for Output Mesh</strong> in Global Settings and re-export. You can re-export without re-solving: open the batch panel, select the completed job, and choose <strong>Re-export</strong> from the job context menu.',
    type: 'output',
  },
  {
    id: 'ci-exit-2',
    symptom: 'Commandlet exits with code 2 immediately',
    cause: 'The commandlet failed to initialize — usually a missing manifest path or missing required plugin.',
    fix: 'Confirm the <code>-manifest</code> path is an absolute filesystem path (not a content path), the file exists, and the host project has MetaHuman and CaptureData plugins enabled in its <code>.uproject</code>. Run with <code>-log</code> to see the startup error.',
    type: 'ci',
  },
];

const typeLabels: Record<string, { label: string; cls: string }> = {
  install:     { label: 'Installation', cls: 'tag-install' },
  queue:       { label: 'Queue',        cls: 'tag-queue'   },
  stereo:      { label: 'Stereo',       cls: 'tag-stereo'  },
  performance: { label: 'Performance',  cls: 'tag-perf'    },
  output:      { label: 'Output',       cls: 'tag-output'  },
  ci:          { label: 'CI Mode',      cls: 'tag-ci'      },
};
---

<DocsLayout
  title="Troubleshooting — MetaHuman Batch Processor"
  description="Solutions to common issues with the MetaHuman Batch Processor plugin."
  currentSlug="troubleshooting"
>

  <div class="doc-header">
    <h1 class="doc-title">Troubleshooting</h1>
    <p class="doc-lead">
      Common issues and how to fix them. Check the job log panel in the batch tab first —
      most failures include a specific error message from the MetaHuman solver.
    </p>
  </div>

  <div class="overview-figures">
    <figure class="doc-figure">
      <div class="doc-img-placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="placeholder-icon"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/><line x1="20" y1="4" x2="20" y2="4.01"/></svg>
        <span class="placeholder-name">ts-validation-error.webp</span>
        <span class="placeholder-hint">Queue row with red X icon visible — tooltip showing "Missing Identity asset" or similar validation message</span>
      </div>
      <figcaption>A validation error on a job row — hover the red X to see the specific missing asset</figcaption>
    </figure>
    <figure class="doc-figure">
      <div class="doc-img-placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="placeholder-icon"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/><line x1="20" y1="4" x2="20" y2="4.01"/></svg>
        <span class="placeholder-name">ts-log-panel-error.webp</span>
        <span class="placeholder-hint">Log panel at the bottom of the batch tab — error message visible in red, stage name shown before it</span>
      </div>
      <figcaption>The log panel showing a solve failure — stage name and error message are your first debugging clues</figcaption>
    </figure>
  </div>

  <nav class="filter-nav" aria-label="Filter by category">
    {Object.entries(typeLabels).map(([key, val]) => (
      <button class="filter-btn" data-filter={key}>{val.label}</button>
    ))}
    <button class="filter-btn active" data-filter="all">All</button>
  </nav>

  <div class="issue-list">
    {issues.map(issue => (
      <div class="issue-card" data-type={issue.type} id={issue.id}>
        <div class="issue-header">
          <span class={`issue-tag ${typeLabels[issue.type].cls}`}>{typeLabels[issue.type].label}</span>
          <h3 class="issue-symptom">{issue.symptom}</h3>
        </div>
        <div class="issue-body">
          <div class="issue-block">
            <span class="issue-block-label">Cause</span>
            <p class="issue-text" set:html={issue.cause} />
          </div>
          <div class="issue-block">
            <span class="issue-block-label">Fix</span>
            <p class="issue-text" set:html={issue.fix} />
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="doc-footer">
    <a href="/marketplace/metahuman-batch-processor/docs/ci-mode" class="prev-link">
      <span class="nav-label">Previous</span>
      <span class="nav-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Headless / CI Mode
      </span>
    </a>
    <a href="/marketplace/metahuman-batch-processor/docs" class="next-link">
      <span class="nav-label">Back to</span>
      <span class="nav-title">
        Documentation
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </a>
  </div>

</DocsLayout>

<style>
  /* Image placeholders */
  .overview-figures { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 28px; }
  .doc-figure { margin: 0; }
  .doc-img-placeholder {
    background: #0a0a0a;
    border: 1px dashed color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: var(--radius);
    padding: 36px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    height: 100%;
    box-sizing: border-box;
  }
  .placeholder-icon { color: var(--text-muted); opacity: 0.35; }
  .placeholder-name { font-family: var(--font-mono); font-size: 0.775rem; color: var(--accent); }
  .placeholder-hint { font-size: 0.775rem; color: var(--text-muted); max-width: 320px; line-height: 1.5; }
  figcaption { font-size: 0.775rem; color: var(--text-muted); text-align: center; margin-top: 8px; font-style: italic; }

  @media (max-width: 640px) { .overview-figures { grid-template-columns: 1fr; } }

  .doc-header { margin-bottom: 32px; }

  .doc-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .doc-lead {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.7;
  }

  /* Filter nav */
  .filter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 28px;
  }

  .filter-btn {
    padding: 5px 14px;
    border-radius: 99px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .filter-btn:hover { color: var(--text); }

  .filter-btn.active {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* Issue cards */
  .issue-list { display: flex; flex-direction: column; gap: 12px; }

  .issue-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .issue-card.hidden { display: none; }

  .issue-header {
    padding: 16px 20px 14px;
    background: var(--bg-card);
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border-bottom: 1px solid var(--border);
  }

  .issue-tag {
    flex-shrink: 0;
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-top: 3px;
    border: 1px solid;
  }

  .tag-install { color: #4a9eff; background: color-mix(in srgb, #4a9eff 10%, transparent); border-color: color-mix(in srgb, #4a9eff 25%, transparent); }
  .tag-queue   { color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); border-color: color-mix(in srgb, var(--accent) 25%, transparent); }
  .tag-stereo  { color: #34d399; background: color-mix(in srgb, #34d399 10%, transparent); border-color: color-mix(in srgb, #34d399 25%, transparent); }
  .tag-perf    { color: #f0a500; background: color-mix(in srgb, #f0a500 10%, transparent); border-color: color-mix(in srgb, #f0a500 25%, transparent); }
  .tag-output  { color: #c084fc; background: color-mix(in srgb, #c084fc 10%, transparent); border-color: color-mix(in srgb, #c084fc 25%, transparent); }
  .tag-ci      { color: #f87171; background: color-mix(in srgb, #f87171 10%, transparent); border-color: color-mix(in srgb, #f87171 25%, transparent); }

  .issue-symptom {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .issue-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .issue-block {
    padding: 14px 20px;
  }

  .issue-block:first-child {
    border-right: 1px solid var(--border);
  }

  .issue-block-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .issue-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  :global(.issue-text strong) { color: var(--text); font-weight: 500; }

  :global(.issue-text code) {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--accent);
    background: var(--bg-surface);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .doc-footer {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .prev-link, .next-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s;
    min-width: 140px;
  }

  .prev-link { align-items: flex-start; }
  .next-link { align-items: flex-end; }
  .prev-link:hover, .next-link:hover { border-color: var(--accent); }

  .nav-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }

  .nav-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .issue-body { grid-template-columns: 1fr; }
    .issue-block:first-child { border-right: none; border-bottom: 1px solid var(--border); }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.issue-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.toggle('active', b === btn));
      const filter = btn.dataset.filter;
      cards.forEach(card => {
        card.classList.toggle('hidden', filter !== 'all' && card.dataset.type !== filter);
      });
    });
  });
</script>
