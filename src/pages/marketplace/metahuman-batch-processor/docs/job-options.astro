---
import DocsLayout from '../../../../layouts/DocsLayout.astro';

const groups = [
  {
    id: 'universal',
    label: 'Universal',
    badge: 'All job types',
    badgeClass: 'badge-all',
    options: [
      { name: 'Frame Exclusion Ranges', type: 'Array of ranges', desc: 'One or more frame ranges to skip during the solve, e.g. <code>0-5, 120-125</code>. Use to cut out blinks, obstructions, equipment glare, or any frames where the face is occluded or corrupted.' },
      { name: 'Show Frames', type: 'Bool', desc: 'Renders preview frames to the viewport during the solve. Useful for debugging to visually confirm the solver is tracking correctly. Slows down processing — disable for production batches.' },
      { name: 'Capture Frame Rate', type: 'Float (optional)', desc: 'Override the frame rate auto-detected from the capture data asset. Leave blank in most cases. Set explicitly if your image sequence lacks embedded timing metadata or if auto-detection gives incorrect results.' },
    ],
  },
  {
    id: 'mono',
    label: 'Mono',
    badge: 'Mono jobs only',
    badgeClass: 'badge-mono',
    options: [
      { name: 'Head Stabilization', type: 'Bool', desc: 'Corrects for drift introduced by head movement across the recording. Enable when the subject moves significantly during the take or when camera stabilization is imperfect. Has a small performance cost.' },
      { name: 'Tongue Solve', type: 'Bool', desc: 'Enables the tongue tracking solver. Requires UE 5.7 or later. Capture quality must be sufficient for tongue visibility — close-framing and good lighting are prerequisites. Disabled by default due to the higher solve time.' },
    ],
  },
  {
    id: 'body-tracking',
    label: 'Body Tracking',
    badge: 'Mono jobs only · UE 5.8+',
    badgeClass: 'badge-body',
    options: [
      { name: 'Body Tracking', type: 'Bool', desc: 'Enables the SMPLX-based body solver alongside the face solve. Requires the <strong>MetaHumanBodyTracker</strong> plugin. Disabled by default — face-only tracking is unaffected when this is off.' },
      { name: 'Face Tracking', type: 'Bool', desc: 'Enabled by default. Disable to skip the face solve entirely for body-only runs — useful when you only need body motion and want to save solve time.' },
      { name: 'Body Height', type: 'Bool + Float (cm)', desc: 'Auto-infers the subject\'s height from footage by default. Disable Auto Body Height to enter a fixed value instead. Epic recommends 145–190cm for best tracking quality.' },
      { name: 'Body Detection Confidence', type: 'Float (0–1)', desc: 'Threshold for initially acquiring a body lock on the subject. Default 0.7. Lower this if the tracker struggles to acquire lock in cluttered or dim footage.' },
      { name: 'Body Tracking Confidence', type: 'Float (0–1)', desc: 'Threshold for maintaining an existing body lock once acquired. Default 0.5. Lower this if the tracker frequently drops lock during fast motion.' },
      { name: 'Enable Foot Locking', type: 'Bool', desc: 'Stabilizes foot contact points to reduce foot sliding during the solve. Enabled by default.' },
      { name: 'Head Allowed Rotation (Left/Right, Up/Down)', type: 'Float (degrees)', desc: 'Yaw and pitch limits beyond which a frame is treated as unsolved for head rotation. Defaults: 45deg left/right, 30deg up/down.' },
      { name: 'Head Rotation Handler', type: 'Enum', desc: 'What to do with frames outside the allowed head rotation range: <strong>None</strong> (leave unsolved) or <strong>Neutral Pose</strong> (substitute a neutral head pose).' },
    ],
  },
  {
    id: 'body-export',
    label: 'Body Export',
    badge: 'Mono jobs only · UE 5.8+ · requires Body Tracking',
    badgeClass: 'badge-body',
    options: [
      { name: 'Export Face / Export Body', type: 'Bool', desc: 'Toggle which solved data streams get baked into the exported AnimSequence. Both enabled by default.' },
      { name: 'Body Export Skeleton', type: 'Enum', desc: '<strong>Performer Skeleton</strong> builds a mesh matching the solve\'s own body-shape betas. <strong>Existing Skeleton</strong> retargets the solved body onto a mesh you choose, via an IK Retargeter.' },
      { name: 'Body Target Mesh', type: 'Object (USkeletalMesh)', desc: 'Shown only when Body Export Skeleton is Existing Skeleton. Per-job override of the global default target mesh; empty falls back to the global default, then the plugin\'s SKM_Body.' },
      { name: 'Body Retargeter', type: 'Object (UIKRetargeter)', desc: 'Shown only when Body Export Skeleton is Existing Skeleton. IK Retargeter used to retarget the solved body onto the Target Mesh. Use the panel\'s <strong>+ Create Retargeter...</strong> button to auto-generate one pre-wired to the SMPL body-tracker source rig — you only need to configure the target chain mapping in the editor that opens.' },
      { name: 'Unsolved Frames', type: 'Enum', desc: 'Fallback for frames the body tracker couldn\'t solve: hold the <strong>Last Valid Frame</strong>, or fall back to a <strong>Neutral Pose</strong>.' },
    ],
  },
  {
    id: 'visualization',
    label: 'Visualization',
    badge: 'All job types',
    badgeClass: 'badge-all',
    options: [
      { name: 'Visualization Mesh / Blueprint', type: 'Object', desc: 'A Skeletal Mesh for face-only jobs, or an Actor Blueprint for body-tracked Mono jobs — MetaHuman Performance requires a Blueprint once body tracking is enabled, since a single mesh can\'t carry both Face and Body. Use the panel\'s <strong>Create Blueprint...</strong> button to auto-build one that leader-poses Face to Body and satisfies MetaHuman Performance\'s requirements.' },
      { name: 'Control Rig', type: 'Class (UControlRig)', desc: 'Overrides the control rig driving this job\'s Performance visualization object. Per-job override takes priority over the global default; empty falls back to the global default, then the engine default.' },
      { name: 'Head Movement Mode', type: 'Enum', desc: 'How head movement is represented on the visualization object: <strong>Transform Track</strong>, <strong>Control Rig</strong>, or <strong>Disabled</strong>.' },
    ],
  },
  {
    id: 'stereo',
    label: 'Stereo',
    badge: 'Stereo jobs only',
    badgeClass: 'badge-stereo',
    options: [
      { name: 'Solve Type', type: 'Enum', desc: 'Selects the internal stereo solver algorithm variant. In most productions the default is correct. Change only when directed by Epic support or when experimenting with non-standard rig configurations.' },
      { name: 'Head Movement Reference Frame', type: 'Int', desc: 'The frame number used as the identity reference for head movement correction. Frame 0 is the default. Set to a frame where the subject is in a neutral, stable pose facing forward.' },
      { name: 'Neutral Pose Calibration', type: 'Bool', desc: 'Uses a dedicated neutral expression frame (separate from the performance footage) to calibrate the facial geometry baseline before solving. Improves accuracy when a calibration take is available.' },
      { name: 'Face Coverage Threshold', type: 'Float (0–1)', desc: 'Minimum proportion of the face that must be visible in the depth map for a frame to be included in the solve. Frames below this threshold are automatically excluded. Raise if you see partial-face frames corrupting the solve.' },
      { name: 'Face Width Threshold', type: 'Float (pixels)', desc: 'Minimum face width in depth pixels required for a frame to be included. Acts alongside Face Coverage Threshold to filter out frames where the face is too far from camera or too small for reliable depth data.' },
      { name: 'Baseline Tolerance', type: 'Float', desc: 'Acceptable deviation between the stereo baseline distance recorded in the camera calibration and what is measured in the live footage. Increase if calibration was done at a slightly different rig configuration than the capture.' },
      { name: 'Scale Tolerance', type: 'Float', desc: 'Acceptable scale mismatch between calibrated and measured stereo geometry. Increase if the rig was adjusted between calibration and capture.' },
      { name: 'Enable Depth Cleaning', type: 'Bool', desc: 'Runs an NNE-based hole-filling pass on the depth sequence before the performance solve. Fills gaps in the depth map within the face region while leaving borders intact. Preserves single-channel GrayF EXR format.' },
      { name: 'Depth Clamp Min', type: 'Float', desc: 'Clips depth values below this threshold to zero before cleaning. Eliminates background or near-field noise that would otherwise be treated as valid face depth.' },
      { name: 'Depth Clamp Max', type: 'Float', desc: 'Clips depth values above this threshold to zero before cleaning. Eliminates far-field objects and reflections that appear in the depth map beyond the face region.' },
    ],
  },
  {
    id: 'audio',
    label: 'Audio',
    badge: 'Audio jobs only',
    badgeClass: 'badge-audio',
    options: [
      { name: 'Solver Mode', type: 'Enum', desc: '<strong>Realtime</strong> — faster solve, lower quality. Suitable for previews and iteration. <strong>Offline</strong> — slower, higher quality. Use for final output deliverables.' },
      { name: 'Mood Preset', type: 'Enum', desc: 'Sets the emotional baseline used to color the generated animation. Available presets: Neutral, Happy, Sad, Angry, Surprised, Disgusted, Fearful. The solver blends the detected phonemes against this mood baseline.' },
      { name: 'Blink Generation', type: 'Bool', desc: 'Auto-generates natural blink keyframes when the audio solve does not produce blink data. Enabled by default. Disable if you are driving blinks from a separate system or if the performance data already includes them.' },
      { name: 'Audio Channel', type: 'Int (0-indexed)', desc: 'Which channel from a multi-track audio asset to use for the lip-sync solve. Defaults to 0 (left/mono). For stereo files where dialogue is on the right channel, set to 1.' },
      { name: 'Lookahead Window', type: 'Int (frames)', desc: 'Number of frames the solver reads ahead in the audio signal to generate anticipatory animation cues — for example, jaw pre-opening before a vowel. Increase for more anticipatory motion; decrease for tighter sync.' },
    ],
  },
];
---

<DocsLayout
  title="Per-Job Options — MetaHuman Batch Processor"
  description="Complete reference for all 45+ per-job solve options in the MetaHuman Batch Processor."
  currentSlug="job-options"
>

  <div class="doc-header">
    <h1 class="doc-title">Per-Job Options</h1>
    <p class="doc-lead">
      Every job in the queue has its own independent set of solve options. Add columns to the
      queue view via the column picker, then edit each cell inline. Settings here override nothing
      at the global level — they are purely per-take controls passed directly to the MetaHuman
      Animator solver.
    </p>
  </div>

  <div class="callout callout-tip">
    <strong>Column picker tip:</strong> Right-click any column header in the queue to open the
    grouped column picker. Options are organized by job type so you only see what's relevant
    to the takes in your batch.
  </div>

  <figure class="doc-figure">
    <div class="doc-img-placeholder">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="placeholder-icon"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/><line x1="20" y1="4" x2="20" y2="4.01"/></svg>
      <span class="placeholder-name">job-options-column-picker.webp</span>
      <span class="placeholder-hint">Column picker dropdown open — grouped sections (Universal, Mono, Stereo, Audio) with checkboxes for each option</span>
    </div>
    <figcaption>The column picker — right-click any column header to open it and toggle which options are visible in the queue</figcaption>
  </figure>

  <figure class="doc-figure" style="margin-bottom: 32px;">
    <div class="doc-img-placeholder">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="placeholder-icon"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/><line x1="20" y1="4" x2="20" y2="4.01"/></svg>
      <span class="placeholder-name">job-options-queue-columns.webp</span>
      <span class="placeholder-hint">Queue with several per-job columns visible — e.g. Head Stabilization, Frame Exclusion, Tongue Solve — cells being edited inline</span>
    </div>
    <figcaption>Multiple per-job options added as columns — edit each cell inline per take</figcaption>
  </figure>

  <nav class="option-nav">
    {groups.map(g => (
      <a href={`#${g.id}`} class="option-nav-link">
        <span class={`badge ${g.badgeClass}`}>{g.label}</span>
      </a>
    ))}
  </nav>

  {groups.map(g => (
    <section class="option-group" id={g.id}>
      <div class="group-header">
        <h2 class="group-title">{g.label} Options</h2>
        <span class={`badge ${g.badgeClass}`}>{g.badge}</span>
      </div>

      <div class="option-list">
        {g.options.map(opt => (
          <div class="option-row">
            <div class="option-meta">
              <span class="option-name">{opt.name}</span>
              <span class="option-type">{opt.type}</span>
            </div>
            <p class="option-desc" set:html={opt.desc} />
          </div>
        ))}
      </div>
    </section>
  ))}

  <div class="doc-footer">
    <a href="/marketplace/metahuman-batch-processor/docs/global-settings" class="prev-link">
      <span class="nav-label">Previous</span>
      <span class="nav-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Global Settings
      </span>
    </a>
    <a href="/marketplace/metahuman-batch-processor/docs/manifests" class="next-link">
      <span class="nav-label">Next</span>
      <span class="nav-title">
        Manifest Format
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </a>
  </div>

</DocsLayout>

<style>
  /* Image placeholders */
  .doc-figure { margin: 20px 0 4px; }
  .doc-img-placeholder {
    background: #0a0a0a;
    border: 1px dashed color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: var(--radius);
    padding: 36px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .placeholder-icon { color: var(--text-muted); opacity: 0.35; }
  .placeholder-name { font-family: var(--font-mono); font-size: 0.775rem; color: var(--accent); }
  .placeholder-hint { font-size: 0.775rem; color: var(--text-muted); max-width: 480px; line-height: 1.5; }
  figcaption { font-size: 0.775rem; color: var(--text-muted); text-align: center; margin-top: 8px; font-style: italic; }

  .doc-header { margin-bottom: 32px; }

  .doc-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .doc-lead {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.7;
  }

  .callout {
    padding: 14px 18px;
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 28px;
    border-left: 3px solid;
  }

  .callout-tip { background: color-mix(in srgb, var(--accent) 8%, transparent); border-color: var(--accent); }
  .callout strong { font-weight: 600; }

  /* Nav */
  .option-nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .option-nav-link { text-decoration: none; }

  /* Badges */
  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid;
  }

  .badge-all    { background: color-mix(in srgb, #888 10%, transparent); color: #aaa; border-color: color-mix(in srgb, #888 25%, transparent); }
  .badge-mono   { background: color-mix(in srgb, #4a9eff 10%, transparent); color: #4a9eff; border-color: color-mix(in srgb, #4a9eff 25%, transparent); }
  .badge-stereo { background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 25%, transparent); }
  .badge-audio  { background: color-mix(in srgb, #c084fc 10%, transparent); color: #c084fc; border-color: color-mix(in srgb, #c084fc 25%, transparent); }
  .badge-body   { background: color-mix(in srgb, #4ade80 10%, transparent); color: #4ade80; border-color: color-mix(in srgb, #4ade80 25%, transparent); }

  /* Option groups */
  .option-group {
    margin-bottom: 56px;
    scroll-margin-top: calc(var(--nav-height) + 24px);
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2px;
  }

  .group-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* Option rows */
  .option-list { display: flex; flex-direction: column; }

  .option-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .option-row:last-child { border-bottom: none; }

  .option-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 1px;
  }

  .option-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .option-type {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .option-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  :global(.option-desc code) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--bg-surface);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  :global(.option-desc strong) { color: var(--text); font-weight: 600; }

  .doc-footer {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .prev-link, .next-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s;
    min-width: 140px;
  }

  .prev-link { align-items: flex-start; }
  .next-link { align-items: flex-end; }
  .prev-link:hover, .next-link:hover { border-color: var(--accent); }

  .nav-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }

  .nav-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .option-row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
