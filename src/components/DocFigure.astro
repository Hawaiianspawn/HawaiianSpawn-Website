---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;

// Astro does not validate public/ references, so a missing screenshot ships as a broken
// image. Omit the figure instead - the prose stands on its own until the shot exists.
// Scripts/Capture-DocShot.ps1 -List in the plugin repo tracks what is still unshot.
const exists = fs.existsSync(path.join(process.cwd(), 'public', src));
if (!exists) {
  console.warn(`[DocFigure] missing image, figure omitted: ${src}`);
}
---

{exists && (
  <figure class="doc-figure">
    <img src={src} alt={alt} />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}

<style>
  .doc-figure { margin: 20px 0; }

  .doc-figure img {
    display: block;
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: 8px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
