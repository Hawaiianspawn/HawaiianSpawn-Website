---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
}

const { title, description, currentSlug = '' } = Astro.props;

const pluginBase = '/marketplace/mha-manager';

const navGroups = [
  {
    label: 'Getting Started',
    items: [
      { slug: 'index',        label: 'Overview',         href: `${pluginBase}/docs` },
      { slug: 'installation', label: 'Installation',     href: `${pluginBase}/docs/installation` },
      { slug: 'quick-start',  label: 'Quick Start',      href: `${pluginBase}/docs/quick-start` },
      { slug: 'ingest',       label: 'Ingest Footage',   href: `${pluginBase}/docs/ingest` },
    ],
  },
  {
    label: 'Workflows',
    items: [
      { slug: 'mono-workflow',   label: 'Mono Workflow',   href: `${pluginBase}/docs/mono-workflow` },
      { slug: 'stereo-workflow', label: 'Stereo Workflow', href: `${pluginBase}/docs/stereo-workflow` },
      { slug: 'audio-workflow',  label: 'Audio Workflow',  href: `${pluginBase}/docs/audio-workflow` },
    ],
  },
  {
    label: 'Reference',
    items: [
      { slug: 'job-types',        label: 'Job Types',         href: `${pluginBase}/docs/job-types` },
      { slug: 'global-settings',  label: 'Global Settings',   href: `${pluginBase}/docs/global-settings` },
      { slug: 'job-options',      label: 'Per-Job Options',   href: `${pluginBase}/docs/job-options` },
      { slug: 'manifests',        label: 'Manifest Format',   href: `${pluginBase}/docs/manifests` },
    ],
  },
  {
    label: 'Advanced',
    items: [
      { slug: 'ci-mode',         label: 'Headless / CI Mode', href: `${pluginBase}/docs/ci-mode` },
      { slug: 'mcp-toolset',     label: 'MCP Toolset',        href: `${pluginBase}/docs/mcp-toolset` },
      { slug: 'troubleshooting', label: 'Troubleshooting',    href: `${pluginBase}/docs/troubleshooting` },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="page-content docs-page">
    <div class="docs-container">

      <aside class="docs-sidebar">
        <a href={pluginBase} class="sidebar-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Plugin page
        </a>
        <nav class="sidebar-nav">
          {navGroups.map(group => (
            <div class="nav-group">
              <span class="nav-group-label">{group.label}</span>
              <ul class="nav-list">
                {group.items.map(item => (
                  <li>
                    <a
                      href={item.href}
                      class={`nav-link${currentSlug === item.slug ? ' active' : ''}`}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <main class="docs-main">
        <slot />
      </main>

    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    padding-bottom: 80px;
  }

  .docs-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 64px;
    align-items: start;
  }

  /* Sidebar */
  .docs-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 40px);
    padding-top: 40px;
  }

  .sidebar-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 28px;
    transition: color 0.2s;
  }

  .sidebar-back:hover { color: var(--text); }

  .nav-group {
    margin-bottom: 24px;
  }

  .nav-group-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
    margin-bottom: 6px;
    padding: 0 8px;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav-link {
    display: block;
    padding: 6px 8px;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--bg-surface);
  }

  .nav-link.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    font-weight: 500;
  }

  /* Main content */
  .docs-main {
    padding-top: 40px;
    min-width: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .docs-container {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .docs-sidebar {
      position: static;
      padding-top: 24px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 32px;
    }

    .sidebar-back { margin-bottom: 16px; }

    .nav-group { margin-bottom: 16px; }

    .nav-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px;
    }

    .nav-link {
      font-size: 0.8rem;
      padding: 4px 10px;
      border: 1px solid var(--border);
    }

    .nav-link.active { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
  }
</style>
