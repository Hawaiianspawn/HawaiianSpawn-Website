---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
}

const { title, description, currentSlug = '' } = Astro.props;

const pluginBase = '/marketplace/mha-manager';

// Grouped by pipeline stage, in the order a take actually travels. A group with no
// label renders as loose links at the bottom of the sidebar. This list is also the
// source of the prev/next links at the foot of every page, so reordering it here
// reorders the whole guide.
const navGroups = [
  {
    label: 'Start Here',
    items: [
      { slug: 'index',        label: 'Overview',       href: `${pluginBase}/docs` },
      { slug: 'installation', label: 'Installation',   href: `${pluginBase}/docs/installation` },
      { slug: 'quick-start',  label: 'Quick Start',    href: `${pluginBase}/docs/quick-start` },
    ],
  },
  {
    label: 'Get Footage In',
    items: [
      { slug: 'ingest',             label: 'Ingest & Add Jobs',  href: `${pluginBase}/docs/ingest` },
      { slug: 'naming-conventions', label: 'Naming Conventions', href: `${pluginBase}/docs/naming-conventions` },
    ],
  },
  {
    label: 'Run a Workflow',
    items: [
      { slug: 'job-types',       label: 'Job Types',       href: `${pluginBase}/docs/job-types` },
      { slug: 'mono-workflow',   label: 'Mono Workflow',   href: `${pluginBase}/docs/mono-workflow` },
      { slug: 'stereo-workflow', label: 'Stereo Workflow', href: `${pluginBase}/docs/stereo-workflow` },
      { slug: 'calibration-quality', label: 'Calibration Quality', href: `${pluginBase}/docs/calibration-quality`, sub: true },
      { slug: 'audio-workflow',  label: 'Audio Workflow',  href: `${pluginBase}/docs/audio-workflow` },
      { slug: 'wwise-audio',     label: 'Wwise Audio',     href: `${pluginBase}/docs/wwise-audio`, sub: true },
    ],
  },
  {
    label: 'Outputs & Review',
    items: [
      { slug: 'exports',                label: 'Exports',                href: `${pluginBase}/docs/exports` },
      { slug: 'level-sequence-preview', label: 'Level Sequence Preview', href: `${pluginBase}/docs/level-sequence-preview` },
    ],
  },
  {
    label: 'Configure',
    items: [
      { slug: 'global-settings', label: 'Global Settings',        href: `${pluginBase}/docs/global-settings` },
      { slug: 'job-options',     label: 'Per-Job Options',        href: `${pluginBase}/docs/job-options` },
      { slug: 'take-overrides',  label: 'Per-Take Overrides',     href: `${pluginBase}/docs/take-overrides` },
      { slug: 'manifests',       label: 'Manifests & Batch Assets', href: `${pluginBase}/docs/manifests` },
    ],
  },
  {
    label: 'Automate',
    items: [
      { slug: 'ci-mode',       label: 'Headless / CI Mode', href: `${pluginBase}/docs/ci-mode` },
      { slug: 'mcp-toolset',   label: 'MCP Toolset',        href: `${pluginBase}/docs/mcp-toolset` },
      { slug: 'claude-skills', label: 'Claude Skills',      href: `${pluginBase}/docs/claude-skills` },
    ],
  },
  {
    label: '',
    items: [
      { slug: 'troubleshooting', label: 'Troubleshooting', href: `${pluginBase}/docs/troubleshooting` },
    ],
  },
];

const flatNav = navGroups.flatMap(g => g.items);
const currentIndex = flatNav.findIndex(item => item.slug === currentSlug);
const prev = currentIndex > 0 ? flatNav[currentIndex - 1] : null;
const next = currentIndex >= 0 ? flatNav[currentIndex + 1] ?? null : null;
---

<BaseLayout title={title} description={description}>
  <div class="page-content docs-page">
    <div class="docs-container">

      <aside class="docs-sidebar">
        <a href={pluginBase} class="sidebar-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Plugin page
        </a>
        <nav class="sidebar-nav">
          {navGroups.map(group => (
            <div class="nav-group">
              {group.label && <span class="nav-group-label">{group.label}</span>}
              <ul class="nav-list">
                {group.items.map(item => (
                  <li>
                    <a
                      href={item.href}
                      class={`nav-link${item.sub ? ' sub' : ''}${currentSlug === item.slug ? ' active' : ''}`}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <main class="docs-main">
        <slot />

        {currentSlug !== 'index' && (prev || next) && (
          <div class="doc-footer">
            {prev && (
              <a href={prev.href} class="prev-link">
                <span class="nav-label">Previous</span>
                <span class="nav-title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                  {prev.label}
                </span>
              </a>
            )}
            {next && (
              <a href={next.href} class="next-link">
                <span class="nav-label">Next</span>
                <span class="nav-title">
                  {next.label}
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            )}
          </div>
        )}
      </main>

    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    padding-bottom: 80px;
  }

  .docs-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 64px;
    align-items: start;
  }

  /* Sidebar */
  .docs-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 40px);
    padding-top: 40px;
  }

  .sidebar-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 28px;
    transition: color 0.2s;
  }

  .sidebar-back:hover { color: var(--text); }

  .nav-group {
    margin-bottom: 24px;
  }

  .nav-group-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text);
    margin-bottom: 6px;
    padding: 0 8px;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav-link {
    display: block;
    padding: 3px 8px;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link.sub {
    padding-left: 22px;
    font-size: 0.8125rem;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--bg-surface);
  }

  .nav-link.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    font-weight: 500;
  }

  /* Main content */
  .docs-main {
    padding-top: 40px;
    min-width: 0;
  }

  /* Prev/next, derived from navGroups */
  .doc-footer {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .prev-link, .next-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s;
    min-width: 140px;
  }

  .prev-link { align-items: flex-start; }
  .next-link { align-items: flex-end; margin-left: auto; }
  .prev-link:hover, .next-link:hover { border-color: var(--accent); }

  .nav-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .nav-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .docs-container {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .docs-sidebar {
      position: static;
      padding-top: 24px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 32px;
    }

    .sidebar-back { margin-bottom: 16px; }

    .nav-group { margin-bottom: 16px; }

    .nav-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px;
    }

    .nav-link {
      font-size: 0.8rem;
      padding: 4px 10px;
      border: 1px solid var(--border);
    }

    .nav-link.active { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
  }
</style>
